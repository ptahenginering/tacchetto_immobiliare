# ============================================================
# RT CASA LIVE — Variabili d'ambiente (copiare in backend/config/.env)
# ============================================================

APP_ENV=local
APP_URL=https://tacchettoimmobiliare.it
CORS_ALLOWED_ORIGINS=https://www.rtimmobiliare.it,https://rtimmobiliare.it,https://tacchettoimmobiliare.it,http://localhost:5173,http://localhost:5174

# --- Database PostgreSQL ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=rtcasalive
DB_USER=rtcasalive
DB_PASSWORD=

# --- JWT ---
JWT_SECRET=
JWT_TTL_ADMIN=28800
JWT_TTL_OWNER=2592000

# --- Admin iniziale ---
ADMIN_EMAIL=admin@rtimmobiliare.it
ADMIN_DEFAULT_PASSWORD=

# --- Email (Brevo primario, SMTP fallback) ---
BREVO_API_KEY=
MAIL_FROM=info@rtimmobiliare.it
MAIL_FROM_NAME="Roberto Tacchetto — RT CASA LIVE"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Lead ---
LEAD_AUTORESPONDER=false

# --- AI (chatbot + generazione testi) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Upload ---
UPLOAD_MAX_MB=8

# --- Migrazioni remote (endpoint protetto) ---
MIGRATION_KEY=

# --- Predisposti per fasi future (lasciare vuoti) ---
META_APP_ID=
META_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
